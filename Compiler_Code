class Solution{
    public:
    void insert_from_front(vector<int> arr,int k){
        
        int n = arr.size();
        
        
        
        vector<int>temp(n+1);
        
        
        temp[0] = (k);
        
        
        int j=0;
        
        for(int i=1; i<temp.size(); i++){
            
            temp[i] = arr[j];
            j++;
        }
        
        for(int i=0; i<temp.size();i++){
            cout<<temp[i]<<endl;
        }

    }
};

int main(){
    
