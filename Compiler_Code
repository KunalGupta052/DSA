//Pair With Given Diff

#include<bits/stdc++.h>
using namespace std;

class Solution{
    public:
        vector<int> pair_diff(vector<int>arr, int target_diff ){
            int n = arr.size();
            int start=0, end = 1;
            
            while(start < n && end < n){
                int Diff = abs(arr[start] - arr[end]);
                if(Diff == target_diff)
                    return{start, end};
                else if(Diff < target_diff)
                     end++;
                else
                start++;
               
            }
            return {};
            
            
        }
    
    
};

int main(){
    int n;
    cin>>n;
    
    
    int target_diff;
    cin>>target_diff;
    
    vector<int>arr(n);
    
    for(int i=0; i<n; i++){
        cin>>arr[i];
    }
    
    Solution obj;
    vector<int> ans = obj.pair_diff(arr, target_diff);
    
    if(ans.empty()){
        cout<<"pair not found"<<endl;
    }
    
    for(int i=0; i<ans.size(); i++)
    cout<<ans[i]<<" ";
    
    cout<<endl;
    
    
    
}
//Candey Store
#include<bits/stdc++.h>
using namespace std;

class Solution{
    public:
    
        pair<int, int> Candy_Store(int candies[], int N, int k){
            int max_cost = 0, min_cost = 0;
            
            sort(candies, candies+N);
            int start = N-1, end = 0;
            while(start >= end){
                    max_cost += candies[start];
                    start--;
                    end+=k;
                    
            }
            
            start = 0, end = N-1;
            while(start < end){
                min_cost += candies[start];
                start++;
                end -= k;
            
            }
                
            return {min_cost, max_cost};
            
        }
};

int main(){
    
    int N;
    cin>>N;
    
    int candies[N];
    
    for(int i=0; i<N;i++)
    cin>>candies[i];
    
    int k;
    cin>>k;
    
    Solution obj;
    
    pair<int, int> ans = obj.Candy_Store(candies,N,k);
    cout<< ans.first<<" "<<ans.second<<endl;
    
    return 0;
}

