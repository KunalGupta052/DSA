//triplet_Sum
#include<bits/stdc++.h>
using namespace std;

class Solution {
  public:
    bool hasTripletSum(vector<int> &arr, int target) {
        // Code Here
     
    sort(arr.begin(), arr.end());
    
    for(int i=0;i<arr.size();i++){
        int ans = target - arr[i];
        int start = i+1 , end = arr.size() - 1;
        
        while(start < end){
            if(arr[start]+arr[end] == ans)
                return 1;
            else if(arr[start]+arr[end] < ans)
                start++;
            else
                end--;
        }
    }
    return 0;
    }
};

int main(){
    int n, target;
    cin>>n;
    
    vector<int> arr(n);
    for(int i=0; i<n; i++)
    cin>>arr[i];
    
    cin>>target;
    
    Solution obj;
    int ans = obj.hasTripletSum(arr, target);
    cout<<ans<< endl;
    
    
    
    return 0;
}

//Max dif between 2 elements
#include<bits/stdc++.h>
using namespace std;

class Solution{
    public:
        int MaxDiff(vector<int> arr){
            int maxdiff = INT_MIN;
            for(int i=0; i<arr.size(); i++){
                int Diff;
                for(int j=i; j<arr.size(); j++){
                    Diff = abs(arr[i]-arr[j]);
                    maxdiff = max(maxdiff, Diff);
                }
            }
        
        return maxdiff;
    }
};
int main(){
    Solution obj;
    
    int n;
    cin>>n;
    
    vector<int>arr(n);
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    
    cout<<obj.MaxDiff(arr)<<endl;
    
    
    
    
    return 0;
}

//Largest sum contiguous subarray
#include<bits/stdc++.h>
using namespace std;

class Solution{
    public:
        int Largest_Sum(vector<int> arr){
            int max_sum = INT_MIN;
            
            int n = arr.size();
            for(int i=0; i<n; i++){
                int sum=0;
                for(int j=i; j<n;j++){
                    sum += arr[j];
                    
                }
                max_sum = max(max_sum, sum); 
                
            }
            return max_sum;
        }
};

int main(){
    int n;
    cin>>n;
    
    vector<int>arr(n);
    
    for(int i=0; i<n; i++){
        cin>>arr[i];
    }
    Solution obj;
    int ans = obj.Largest_Sum(arr);
    cout<<ans;
    
    
    
    return 0;
    
}
//Divide the array in 2 subarray with eqqual sum

#include<bits/stdc++.h>
using namespace std;

class Solution{
    public:
        bool Divide_Array_in_Subarray(vector<int>arr){
            
            for(int i=0; i<arr.size(); i++){
                int sum1=0, sum2 = 0;
                for(int j=0 ; j<i; j++){
                    sum1 += arr[j]; 
                }
                for(int j=i; j<arr.size()-1; j++){
                    sum2 += arr[j];
                }
                if(sum1 == sum2)
                return 1;
                
            }
            return {};
            
        }
};
