//Spiral Form
#include<bits/stdc++.h>
using namespace std;

class Solution{
    public:
        int Spiral_form(vector<vector<int> >&Mat){
            
            int row = Mat.size();
            int col = Mat[0].size();
            
            int top = 0;
            int right = col-1;
            int left = 0;
            int bottom = row-1;
            
            while(top<=bottom && left<=right){
                
                for(int j=left; j<=right; j++){
                    cout<<Mat[top][j]<<" ";  
                }
               
                top++;
                 
                
                for(int j=top; j<=bottom; j++){
                    cout<<Mat[j][right]<<" ";
                    
                }
                
                right--;
               
                
                for(int j=right; j>=left; j--){
                    cout<<Mat[bottom][j]<<" ";
                    
                }
                
                bottom--;
               
                
                for(int j=bottom; j>=top; j--){
                    cout<<Mat[j][left]<<" ";
                    
                }
                
                left++;
        
            }
             
           
            
            return 0;
            
        }
    
};

