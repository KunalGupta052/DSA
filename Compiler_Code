    for(int i=0; i<n; i++){
        cout<<ans[i]<<" ";
    }
    
    cout<<endl;
    
    
    return 0;
}


//Pair With Given Diff

#include<bits/stdc++.h>
using namespace std;

class Solution{
    public:
        vector<int> pair_diff(vector<int>arr, int target_diff ){
            int n = arr.size();
            int start=0, end = 1;
            
            while(start < n && end < n){
                int Diff = abs(arr[start] - arr[end]);
                if(Diff == target_diff)
                    return{start, end};
                else if(Diff < target_diff)
                     end++;
                else
                start++;
               
            }
            return {};
            
            
        }
    
    
};

int main(){
    int n;
    cin>>n;
    
    
    int target_diff;
    cin>>target_diff;
    
    vector<int>arr(n);
    
    for(int i=0; i<n; i++){
        cin>>arr[i];
    }
    
    Solution obj;
    vector<int> ans = obj.pair_diff(arr, target_diff);
    
    if(ans.empty()){
        cout<<"pair not found"<<endl;
    }
    
    for(int i=0; i<ans.size(); i++)
    cout<<ans[i]<<" ";
    
    cout<<endl;
    
    
    
}
