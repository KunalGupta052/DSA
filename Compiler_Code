//Smallest window length with All
#include<bits/stdc++.h>
using namespace std;

class Solution{
    public:
        int Smallest_window_lenght_with_All(string s){

            unordered_set<char>hs;
        
            for(int i=0;i<s.size();i++){
                hs.insert(s[i]);
            }
            
            int required = hs.size();
            
            unordered_map<char,int>hm;
            int ans = s.size();
            
            int l=0;
            
            int count=0;
            
            for(int r=0; r<s.size(); r++){
                hm[s[r]]++;
                
                if(hm[s[r]] == 1)
                count++;
                
                while(count == required){
                    ans = min(ans, r-l+1);
                    
                    hm[s[l]]--;
                    
                    if(hm[s[l]]==0)
                    hm.erase(s[l]);
                    count--;
                    
                    l++;
                }
                
                
            }
            return ans;
        }
};
int main(){
    
    string s;
    cin>>s;
    
    Solution obj;
    
    cout<<obj.Smallest_window_lenght_with_All(s)<<endl;
    
    
    
    return 0;
}

