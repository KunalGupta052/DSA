//triplet_Sum
#include<bits/stdc++.h>
using namespace std;

class Solution {
  public:
    bool hasTripletSum(vector<int> &arr, int target) {
        // Code Here
     
    sort(arr.begin(), arr.end());
    
    for(int i=0;i<arr.size();i++){
        int ans = target - arr[i];
        int start = i+1 , end = arr.size() - 1;
        
        while(start < end){
            if(arr[start]+arr[end] == ans)
                return 1;
            else if(arr[start]+arr[end] < ans)
                start++;
            else
                end--;
        }
    }
    return 0;
    }
};

int main(){
    int n, target;
    cin>>n;
    
    vector<int> arr(n);
    for(int i=0; i<n; i++)
    cin>>arr[i];
    
    cin>>target;
    
    Solution obj;
    int ans = obj.hasTripletSum(arr, target);
    cout<<ans<< endl;
    
    
    
    return 0;
}
