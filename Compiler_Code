    vector<int>arr(n);
    
    for(int i=0; i<n; i++){
        cin>>arr[i];
    }
    
    int k;
    cin>>k;
    
    Solution obj;
    obj.insert_from_front(arr, k);
    
    return 0;
}
//Print array with same order and non duplicate 

#include<bits/stdc++.h>
using namespace std;

class Solution{
    
    public:
        void return_arr(vector<int> arr){
            
            unordered_set<int>hs;
            
            vector<int>ans;
            
            
            for(int i=0; i<arr.size(); i++){
                if(!hs.count(arr[i])){
                    ans.push_back(arr[i]);
                    hs.insert(arr[i]);
                }
                else
                continue;
                
            }
            for(int i=0; i<ans.size();i++)
            cout<<ans[i]<<" ";
            
        }
};

int main(){
    
    int n;
    cin>>n;
    
    vector<int>arr(n);
    
    for(int i=0; i<n; i++){
        cin>>arr[i];
    }
    
    
    Solution obj;
    obj.return_arr(arr);
    
    
    
    return 0;
}
