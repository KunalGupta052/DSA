//Largest sum contiguous subarray
#include<bits/stdc++.h>
using namespace std;

class Solution{
    public:
        int Largest_Sum(vector<int> arr){
            int max_sum = INT_MIN;
            
            int n = arr.size();
            for(int i=0; i<n; i++){
                int sum=0;
                for(int j=i; j<n;j++){
                    sum += arr[j];
                    
                }
                max_sum = max(max_sum, sum); 
                
            }
            return max_sum;
        }
};

