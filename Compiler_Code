//Check if the string is rotated by 2 places

#include<bits/stdc++.h>
using namespace std;

class Solution{
    public:
            
            void rotatedclockwise(string &s){
                char ch = s[s.size()-1];
                for(int i=s.size()-2; i>0; i--){
                    
                    s[i] = s[i+1];
                }
                s[0] = ch;
            }
            void rotatedanticlockwise(string &s){
                char ch = s[0];
                for(int i=1; i<s.size(); i++){
                    
                    s[i] = s[i-1];
                }
                s[s.size()-1] = ch;
            
            }
        
    
    bool Check_if_string_rotated_by_2_place(string str1, string str2){
        
        if(str1.size() != str2.size())
        return 0;
        
        string clockwise, anticlockwise;
        
        clockwise = str1;
        
        rotatedclockwise(clockwise);
        rotatedclockwise(clockwise);
        
        
        if(clockwise == str2)
        return 1;
        
        anticlockwise = str1;
        
        rotatedanticlockwise(anticlockwise);
        rotatedanticlockwise(anticlockwise);
        
        if(anticlockwise == str2)
        return 1;
        
        return 0;
        
  
    }
};

int main(){
    
    string str1;
    cin>>str1;
    
    string str2;
    cin>>str2;
    
    Solution obj;
    cout<<obj.Check_if_string_rotated_by_2_place(str1, str2);
    
    return 0;
}

