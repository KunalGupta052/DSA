#include<bits/stdc++.h>
using namespace std;

class Solution{
    public:
        int diagonalSum(vector<vector<int>>& Mat, int n){
            
            int first=0, second =0;
            
            for(int i=0; i<n; i++)
                
                first += Mat[i][i];
            
            for(int i=0, j=n-1 ;i<n; i++, j--)
                second += Mat[i][j];
            
            
            //To avoid the count of middle diagonal element to time 
            if(n % 2 != 0)
                second -= Mat[n/2][n/2];
            
            
            
            return first+second;
        }
};
