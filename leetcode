//LEETCODE-451
class Solution {
public:
    string frequencySort(string s) {
        unordered_map<char, int>hm;
        vector<pair<int, char>>arr;

        for(int i=0;i<s.size();i++){
            hm[s[i]]++;
        }

        for(auto x:hm){
            arr.push_back({x.second, x.first});
            
        }
        sort(arr.begin(),arr.end(), greater<pair<int,char>>());
        
        string ans = "";

        for(auto x:arr){
            for(int i=0; i<x.first; i++){
                ans += x.second;
            }
        }
        return ans;
    }
};
