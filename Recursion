#include<bits/stdc++.h>
using namespace std;
int recurssionAdd(int n){
    if(n==0){
        return 0;
        
    }
    return n + recurssionAdd(n-1);
}
int main(){
    
    int n;
    cin>>n;
    
    cout<<recurssionAdd(n);
    return 0;
    
}


//Bubble Sort
#include<bits/stdc++.h>
using namespace std;

void bubble_sort(int* arr, int n){
    if(n==1){
        return;
    }
    
    for(int i=0; i< n-1; i++){
        if(arr[i] > arr[i+1]){
            swap(arr[i], arr[i+1]);
        }
    }
    
    bubble_sort(arr, n-1);
}

int main(){
    int n = 5;
    
    int arr[n] = {5, 7, 3, 0, 1};
    
    bubble_sort(arr, n);
    
    for(int i=0; i<n; i++){
        cout<<arr[i]<<" ";
    }
    
    
    return 0;
    
    
}
