//Smallest maxSumSubarray

#include <bits/stdc++.h>
using namespace std;
int smallestSubarray(vector<int> &arr, int target){
    int n = arr.size();
    int i = 0;
    int sum = 0;
    int min_Len = INT_MAX;
    
    // expand the window using right pointer 'j'
    
    for(int j=0; j<n;j++){
        sum += arr[j];
        while(sum >= target){
            min_Len = min(min_Len, j-i+1);
            sum = sum - arr[i];
            i++;
            
        }
        
    }
    return min_Len;
}
int main()
{
     vector<int> arr = {2, 1, 5, 1, 3, 2};
    
     cout<<smallestSubarray(arr, 3);
    
     return 0;
}
