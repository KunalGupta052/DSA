#include<bits/stdc++.h>
using namespace std;

template<typename T>
T findmaxElement(T arr[], T size){
    T maxVal = arr[0];
    for(int i=0; i<size; i++){
        if(arr[i] > maxVal){
            maxVal = arr[i];
        }
    }
    return maxVal;
}

//Sorting Template(Bubble Sort)

template<typename T>
void SortArray(T arr[],int size){
    for(int i=0; i<size-1; i++){
        for(int j=0; j<size-1; j++){
            if(arr[j]>arr[j+1]){
                T temp = arr[i];
                arr[j] = arr[j+1];
                arr[j+1]= temp;
                
            }
        }
    }
}
