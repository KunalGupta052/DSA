//String Rotated by 2 Places
Class Solution{
    public:
    void rotateclockwise(string &s){
        
        char c = s[s.size()-1];
        index = s.size() - 2;
        while(index < s.size()){
            s[index+1] = s[index];
            index--;
            
        }
        s[0] = c;
        
    }
    
    void rotateanticlockwise(string &s){
        
        char c = s[0];
        index = 1;
        while(index < s.size()){
            s[index-1] = s[index];
            index++;
            
        }
        s[s.size()-1] = c;
        
    }
    bool isRotate(string str1, string str2){
        if(str1.size() != str2.size())
        return 0;
        
        clockwise = str1;
        rotateclockwise(clockwise);
        rotateclockwise(clockwise);
        
        if(clockwise == str2)
        return 1;
        
        anticlockwise = str1;
        rotateanticlockwise(anticlockwise);
        rotateanticlockwise(anticlockwise);
        
        if(anticlockwise == str2)
        return 1;
        
        return 0;
        
    }
    
}

//Triplet_Sum
class Solution {
  public:
    bool hasTripletSum(vector<int> &arr, int target) {
        // Code Here
     
    sort(arr.begin(), arr.end());
    
    for(int i=0;i<arr.size();i++){
        int ans = target - arr[i];
        int start = i+1 , end = arr.size() - 1;
        
        while(start < end){
            if(arr[start]+arr[end] == ans)
                return 1;
            else if(arr[start]+arr[end] < ans)
                start++;
            else
                end--;
        }
    }
    return 0;
    }
};

// Smallest Window Length with All

class Solution {
  public:
    int findSubString(string& s) {
        // code here
        unordered_set<char>hs;
        
        for(char ch : s){
            hs.insert(ch);
        }
        
        int required = hs.size(); 
        
        unordered_map<char, int>hm;
        
        int l = 0;
        int count = 0;
        int ans =  s.size();
        
        for(int r=0; r<s.size(); r++){
            
            hm[s[r]]++;
        
            
            if(hm[s[r]] == 1)
                count++;
                
                while(count == required){
                    ans = min(ans, r-l+1);
                    hm[s[l]]--;
                    
                    
                    if(hm[s[l]]==0)
                        count--;
                        
                    l++;
                        
                    
                }
                
            
            
        }
        return ans;
        
    }
};
